{
  // Docker bridge mode needs the process to listen on the container interface.
  // Host exposure stays local-only via docker port bindings in .env.
  gateway: {
    mode: "local",
    bind: "lan",
    auth: {
      mode: "token",
      allowTailscale: false,
    },
    controlUi: {
      enabled: true,
      allowedOrigins: [
        "http://127.0.0.1:18789",
        "https://laptop-hacnr4t5.taildcef12.ts.net",
      ],
    },
    tailscale: {
      mode: "off",
    },
    reload: {
      mode: "hybrid",
    },
  },

  agents: {
    defaults: {
	thinkingDefault: "high",
      model: {
        primary: "rightcode/gpt-5.4-high",
      },
      sandbox: {
        mode: "off",
      },
    },
  },

  tools: {
    profile: "coding",
  },

  models: {
    mode: "merge",
    providers: {
      rightcode: {
        baseUrl: "https://right.codes/codex/v1",
        apiKey: "${RIGHTCODE_API_KEY}",
        api: "openai-responses",
        authHeader: true,
        models: [
          {
            id: "gpt-5.4",
            name: "GPT-5.4 (RightCode)",
            api: "openai-responses",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 128000,
            maxTokens: 32000,
          },
        ],
      },
    },
  },

  // Fill your model/provider secrets manually before first real use.
  // RIGHTCODE_API_KEY lives in .env.
}
